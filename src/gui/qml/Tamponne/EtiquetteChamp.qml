import QtQuick
import Tamponne

/*! Petit intitulé de champ en capitales à chasse fixe (« TYPE », « DATE »). */
Texte {
    color: Theme.encre2
    font.family: Theme.policeMono
    font.pixelSize: 13
    font.weight: Font.DemiBold
    font.capitalization: Font.AllUppercase
    font.letterSpacing: 0.5
    wrapMode: Text.NoWrap
}
